---
/* SEO de cada página: título, descrição, canonical no domínio principal,
   prévias de compartilhamento (Open Graph / X) e dados estruturados. */
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, imageAlt, type = 'website', published, updated, jsonLd } = Astro.props;

const site = 'https://joaoa.com.br';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? '/blog/og/og-blog.jpg', site).href;
const ogAlt = imageAlt ?? 'Blog de João Alberto: design, email HTML, CRM e web';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f2f0eb" media="(prefers-color-scheme: light)" />
<meta name="color-scheme" content="dark light" />

<!-- Tema do blog: a escolha salva no botão vale; sem escolha, segue o sistema.
     Roda antes da pintura para a página não piscar no tema errado. -->
<script is:inline>
  (() => {
    let saved = null;
    try { saved = localStorage.getItem('joaoa-blog-theme'); } catch {}
    const light = saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
    document.documentElement.classList.toggle('light', light);
  })();
</script>
<meta name="author" content="João Alberto" />

<meta property="og:locale" content="pt_BR" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="João Alberto" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === 'article' && <meta property="article:author" content="https://joaoa.com.br/" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />

<link rel="alternate" type="application/rss+xml" title="Blog de João Alberto" href={`${site}${base}/rss.xml`} />
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${base}/img/apple-touch-icon.png`} />
<link rel="preload" href={`${base}/fonts/instrument-sans-latin.woff2`} as="font" type="font/woff2" crossorigin="" />
<link rel="stylesheet" href={`${base}/css/fonts.css`} />
<link rel="stylesheet" href={`${base}/css/icons.css`} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Analytics apenas no domínio publicado: não conta testes locais nem deploy previews. -->
<script is:inline>if(/^(www\.)?joaoa\.com\.br$/.test(location.hostname)){const s=document.createElement("script");s.src="https://analytics-hub-production-9abd.up.railway.app/t.js";s.dataset.key="pk_J6q-HyvEwzSgOsFA5fSfirbjriPcvcSf";s.defer=true;document.head.appendChild(s);}</script>
