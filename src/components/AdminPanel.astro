---
/* Painel de publicação do blog: /blog/admin/ (e os links dos e-mails do Authik:
   /blog/admin/verificar-email/ e /blog/admin/redefinir-senha/).
   Entra pela conta do Authik; os posts são gravados no GitHub pelo publicador.
   Fica fora do Google (noindex) e fora do sitemap. */
import '../styles/global.css';
import '../styles/admin.css';
import { CATEGORIES } from '../lib/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Painel do blog | João Alberto</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}/css/fonts.css`} />
    <link rel="stylesheet" href={`${base}/css/icons.css`} />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('joaoa-blog-theme'); } catch {}
        const light = saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.classList.toggle('light', light);
      })();
    </script>
  </head>
  <body class="admin" data-categories={JSON.stringify(CATEGORIES)}>
    <header class="adm-bar">
      <a class="nav-logo" href={`${base}/`}>João Alberto <span class="adm-tag mono">Painel do blog</span></a>
      <div class="adm-bar-actions">
        <a class="adm-link" href={`${base}/`} target="_blank" rel="noopener">Ver blog <i aria-hidden="true" class="fa-solid fa-arrow-up-right-from-square"></i></a>
        <button class="adm-link" id="logout" type="button" hidden>Sair</button>
      </div>
    </header>

    <main class="adm-main">
      <!-- ============ ENTRAR ============ -->
      <section class="adm-view adm-login" id="viewLogin" hidden>
        <p class="kicker mono"><span class="rule"></span>Acesso</p>
        <h1 class="adm-title">Painel do blog<span class="dot">.</span></h1>
        <p class="adm-text">Entre com a sua conta para escrever e publicar posts. O site é atualizado em cerca de um minuto depois de publicar.</p>
        <form class="adm-login-form" id="loginForm">
          <label class="adm-field">
            <span class="mono">E-mail</span>
            <input id="loginEmail" type="email" autocomplete="username" required />
          </label>
          <label class="adm-field">
            <span class="mono">Senha</span>
            <input id="loginPassword" type="password" autocomplete="current-password" required />
          </label>
          <button class="btn" type="submit"><span>Entrar</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></button>
          <p class="adm-error" id="loginError" role="alert"></p>
        </form>
        <p class="adm-auth-links">
          <button class="adm-link" type="button" id="forgotHelp">Esqueci a senha</button>
          <button class="adm-link" type="button" data-go="viewSignup">Primeiro acesso</button>
        </p>
      </section>

      <!-- ============ PRIMEIRO ACESSO ============ -->
      <section class="adm-view adm-login" id="viewSignup" hidden>
        <p class="kicker mono"><span class="rule"></span>Primeiro acesso</p>
        <h1 class="adm-title">Criar conta<span class="dot">.</span></h1>
        <p class="adm-text">Depois de criar a conta, peça ao administrador do blog para liberar a sua conta para publicar.</p>
        <form class="adm-login-form" id="signupForm">
          <label class="adm-field">
            <span class="mono">Nome</span>
            <input id="signupName" type="text" autocomplete="name" maxlength="100" required />
          </label>
          <label class="adm-field">
            <span class="mono">E-mail</span>
            <input id="signupEmail" type="email" autocomplete="email" required />
          </label>
          <label class="adm-field">
            <span class="mono">Senha</span>
            <input id="signupPassword" type="password" autocomplete="new-password" required />
            <small>Pelo menos 8 caracteres, com letra, número e um caractere especial.</small>
          </label>
          <label class="adm-field">
            <span class="mono">Repita a senha</span>
            <input id="signupPassword2" type="password" autocomplete="new-password" required />
          </label>
          <button class="btn" type="submit"><span>Criar conta</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></button>
          <p class="adm-error" id="signupError" role="alert"></p>
        </form>
        <p class="adm-auth-links"><button class="adm-link" type="button" data-go="viewLogin"><i aria-hidden="true" class="fa-solid fa-arrow-left"></i> Voltar para entrar</button></p>
      </section>

      <!-- ============ NOVA SENHA (link do e-mail) ============ -->
      <section class="adm-view adm-login" id="viewReset" hidden>
        <p class="kicker mono"><span class="rule"></span>Senha</p>
        <h1 class="adm-title">Nova senha<span class="dot">.</span></h1>
        <form class="adm-login-form" id="resetForm">
          <label class="adm-field">
            <span class="mono">Nova senha</span>
            <input id="resetPassword" type="password" autocomplete="new-password" required />
            <small>Pelo menos 8 caracteres, com letra, número e um caractere especial.</small>
          </label>
          <label class="adm-field">
            <span class="mono">Repita a senha</span>
            <input id="resetPassword2" type="password" autocomplete="new-password" required />
          </label>
          <button class="btn" type="submit"><span>Salvar senha</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></button>
          <p class="adm-error" id="resetError" role="alert"></p>
        </form>
      </section>

      <!-- ============ AVISOS (e-mail confirmado, conta sem permissão…) ============ -->
      <section class="adm-view adm-login" id="viewNotice" hidden>
        <p class="kicker mono"><span class="rule"></span>Acesso</p>
        <h1 class="adm-title" id="noticeTitle"></h1>
        <p class="adm-text" id="noticeText"></p>
        <p class="adm-auth-links"><button class="btn" type="button" id="noticeAction"><span>Entrar</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></button></p>
      </section>

      <!-- ============ LISTA ============ -->
      <section class="adm-view" id="viewList" hidden>
        <div class="adm-list-head">
          <div>
            <p class="kicker mono"><span class="rule"></span>Posts</p>
            <h1 class="adm-title">Seus posts<span class="dot">.</span></h1>
          </div>
          <button class="btn" id="newPost" type="button"><span>Novo post</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></button>
        </div>
        <div class="adm-filters" role="search">
          <label class="adm-search">
            <span class="sr-only">Buscar posts</span>
            <input id="filterSearch" type="search" placeholder="Buscar por título, resumo ou tag" autocomplete="off" />
          </label>
          <label class="adm-select">
            <span class="sr-only">Tema</span>
            <select id="filterTheme">
              <option value="">Todos os temas</option>
              {CATEGORIES.map((category) => <option value={category.slug}>{category.name}</option>)}
            </select>
          </label>
          <div class="adm-segment" role="group" aria-label="Status">
            <button type="button" data-status="" aria-pressed="true">Todos</button>
            <button type="button" data-status="live" aria-pressed="false">Publicados</button>
            <button type="button" data-status="draft" aria-pressed="false">Rascunhos</button>
          </div>
          <label class="adm-select">
            <span class="sr-only">Ordenar</span>
            <select id="filterSort">
              <option value="new">Mais recentes</option>
              <option value="old">Mais antigos</option>
              <option value="az">Título (A–Z)</option>
            </select>
          </label>
        </div>
        <p class="adm-status" id="listStatus" role="status"></p>
        <ul class="adm-list" id="postList"></ul>
      </section>

      <!-- ============ EDITOR ============ -->
      <section class="adm-view" id="viewEditor" hidden>
        <form id="editor" class="adm-editor" novalidate>
          <div class="adm-editor-top">
            <button class="adm-link" id="backToList" type="button"><i aria-hidden="true" class="fa-solid fa-arrow-left"></i> Todos os posts</button>
            <span class="adm-badge mono" id="stateBadge"></span>
            <div class="adm-editor-actions">
              <button class="adm-btn adm-btn--danger" id="deletePost" type="button" hidden>Excluir</button>
              <button class="adm-btn" id="saveDraft" type="button">Salvar rascunho</button>
              <button class="btn" id="publish" type="button"><span>Publicar</span><i aria-hidden="true" class="fa-solid fa-arrow-up"></i></button>
            </div>
          </div>
          <p class="adm-status" id="editorStatus" role="status"></p>

          <div class="adm-editor-grid">
            <div class="adm-editor-main">
              <textarea class="adm-title-input" id="title" rows="1" placeholder="Título do post" aria-label="Título" required></textarea>

              <div class="adm-tabs" role="tablist" aria-label="Texto do post">
                <button type="button" role="tab" id="tabWrite" aria-selected="true" aria-controls="panelWrite">Escrever</button>
                <button type="button" role="tab" id="tabPreview" aria-selected="false" aria-controls="panelPreview">Pré-visualizar</button>
              </div>

              <div id="panelWrite" role="tabpanel" aria-labelledby="tabWrite">
                <div class="adm-toolbar" role="toolbar" aria-label="Formatação">
                  <button type="button" data-md="h2" title="Título de seção">H2</button>
                  <button type="button" data-md="h3" title="Subtítulo">H3</button>
                  <button type="button" data-md="bold" title="Negrito"><strong>B</strong></button>
                  <button type="button" data-md="italic" title="Itálico"><em>I</em></button>
                  <button type="button" data-md="link" title="Link"><i aria-hidden="true" class="fa-solid fa-link"></i></button>
                  <button type="button" data-md="list" title="Lista">Lista</button>
                  <button type="button" data-md="check" title="Checklist">Checklist</button>
                  <button type="button" data-md="quote" title="Citação">Citação</button>
                  <button type="button" data-md="code" title="Código na linha">`código`</button>
                  <button type="button" data-md="block" title="Bloco de código">Bloco de código</button>
                </div>
                <textarea id="body" class="adm-body" spellcheck="true" placeholder="Escreva o post em Markdown…"></textarea>
              </div>

              <div id="panelPreview" role="tabpanel" aria-labelledby="tabPreview" hidden>
                <div class="prose adm-preview" id="preview"></div>
              </div>
            </div>

            <aside class="adm-editor-side" aria-label="Detalhes do post">
              <label class="adm-field">
                <span class="mono">Endereço</span>
                <div class="adm-slug"><span>/blog/</span><input id="slug" type="text" spellcheck="false" /><span>/</span></div>
                <small id="slugHint">Gerado a partir do título. Depois de publicado, não muda.</small>
              </label>

              <label class="adm-field">
                <span class="mono">Resumo <em id="descCount">0/170</em></span>
                <textarea id="description" rows="4" maxlength="170" placeholder="Aparece no Google, nas prévias de link e nos cards do blog."></textarea>
              </label>

              <div class="adm-row">
                <label class="adm-field">
                  <span class="mono">Data de publicação</span>
                  <input id="date" type="date" required />
                </label>
                <label class="adm-field">
                  <span class="mono">Tema</span>
                  <select id="category" required>
                    {CATEGORIES.map((category) => <option value={category.slug}>{category.name}</option>)}
                  </select>
                </label>
              </div>

              <label class="adm-field">
                <span class="mono">Tags</span>
                <input id="tags" type="text" placeholder="Separadas por vírgula" />
              </label>

              <div class="adm-field">
                <span class="mono">Capa</span>
                <div class="adm-cover" id="coverBox">
                  <img id="coverPreview" alt="" hidden />
                  <p id="coverEmpty">Sem capa: o post usa a capa tipográfica.</p>
                </div>
                <div class="adm-cover-actions">
                  <label class="adm-btn adm-file">
                    <input id="coverFile" type="file" accept="image/png,image/jpeg,image/webp" />
                    Escolher imagem
                  </label>
                  <button class="adm-btn" id="coverRemove" type="button" hidden>Remover</button>
                </div>
                <small>Ideal 16:10 (ex.: 3200×2000). Convertida para WebP antes de enviar.</small>
                <input id="coverAlt" type="text" placeholder="Descrição da capa (acessibilidade)" />
              </div>

              <label class="adm-check">
                <input id="featured" type="checkbox" />
                <span>Fixar como destaque no topo do blog</span>
              </label>
            </aside>
          </div>
        </form>
      </section>
    </main>

    <script src="../scripts/admin/app.js"></script>
  </body>
</html>
