---
/* Moldura de todas as páginas do blog: a mesma navegação e o mesmo
   rodapé do portfólio, para o leitor não perceber que são dois projetos. */
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

type Props = ComponentProps<typeof BaseHead>;
const props = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-nav" id="nav">
      <a class="nav-logo" href="/" aria-label="João Alberto — página inicial">João Alberto</a>
      <nav class="nav-menu" aria-label="Navegação principal">
        <ul class="nav-links">
          <li><a href="/#topo">Início</a></li>
          <li><a href="/#sobre">Sobre</a></li>
          <li><a href="/projetos/">Projetos</a></li>
          <li><a href="/blog/" aria-current="page">Blog</a></li>
        </ul>
        <button class="theme-toggle" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Ativar tema claro">
          <span class="knob" aria-hidden="true"><i class="fa-solid fa-moon"></i></span>
        </button>
        <a class="nav-cta" href="/#contato">
          Fale comigo
          <i aria-hidden="true" class="fa-solid fa-arrow-right"></i>
        </a>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <p>João Alberto © {new Date().getFullYear()} — Design digital &amp; web</p>
        <p class="mono">joaoa.com.br / blog</p>
      </div>
      <div class="footer-end">
      <nav class="footer-links" aria-label="Redes sociais">
        <a href="https://github.com/joaoa21" rel="noopener" target="_blank" aria-label="GitHub"><i aria-hidden="true" class="fa-brands fa-github"></i></a>
        <a href="https://www.instagram.com/joaoalbertoms2/" rel="noopener" target="_blank" aria-label="Instagram"><i aria-hidden="true" class="fa-brands fa-instagram"></i></a>
        <a href="https://www.linkedin.com/in/joaoa210/" rel="noopener" target="_blank" aria-label="LinkedIn"><i aria-hidden="true" class="fa-brands fa-linkedin-in"></i></a>
      </nav>
      <a class="to-top" href="#conteudo" aria-label="Voltar ao topo"><i aria-hidden="true" class="fa-solid fa-arrow-up"></i></a>
      </div>
    </footer>

    <script>
      // a navegação vira a "pílula" de vidro ao rolar, como no portfólio
      const nav = document.getElementById('nav');
      const sync = () => nav?.classList.toggle('scrolled', window.scrollY > 40);
      sync();
      window.addEventListener('scroll', sync, { passive: true });

      // tema claro/escuro: o botão salva a escolha; sem escolha salva, acompanha o sistema
      const root = document.documentElement;
      const toggle = document.getElementById('themeToggle');
      const system = window.matchMedia('(prefers-color-scheme: light)');
      const KEY = 'joaoa-blog-theme';

      const paint = () => {
        const light = root.classList.contains('light');
        toggle?.setAttribute('aria-checked', String(light));
        toggle?.setAttribute('aria-label', light ? 'Ativar tema escuro' : 'Ativar tema claro');
        const icon = toggle?.querySelector('.knob i');
        if (icon) icon.className = light ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      };

      paint();

      toggle?.addEventListener('click', () => {
        const light = !root.classList.contains('light');
        root.classList.toggle('light', light);
        try { localStorage.setItem(KEY, light ? 'light' : 'dark'); } catch {}
        paint();
      });

      system.addEventListener('change', (event) => {
        let saved = null;
        try { saved = localStorage.getItem(KEY); } catch {}
        if (saved) return;
        root.classList.toggle('light', event.matches);
        paint();
      });
    </script>
    <!-- Atalho do painel: só aparece em navegadores onde o autor entrou no painel.
         Visitantes não têm o login salvo, então não veem nada. -->
    <a class="admin-shortcut" id="adminShortcut" href="/blog/admin/" hidden>
      <i aria-hidden="true" class="fa-solid fa-link"></i>
      <span>Painel</span>
    </a>
    <script>
      (() => {
        let token = null;
        try {
          token = localStorage.getItem('joaoa-blog-admin-token') || sessionStorage.getItem('joaoa-blog-admin-token');
        } catch {}
        if (!token) return;
        const link = document.getElementById('adminShortcut');
        const slug = document.querySelector('[data-post-slug]')?.getAttribute('data-post-slug');
        if (!link) return;
        if (slug) {
          link.href = '/blog/admin/?post=' + encodeURIComponent(slug);
          link.querySelector('span').textContent = 'Editar post';
        }
        link.hidden = false;
      })();
    </script>
  </body>
</html>
