---
/* Home do blog em formato de revista. O layout cresce com o conteúdo:
   1 post → só o destaque; até 5 → destaque + laterais; mais → "Mais recentes";
   temas com 2+ posts ganham seção própria. */
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThemeBar from '../components/ThemeBar.astro';
import { getPosts, pickFeatured, groupByCategory, postUrl } from '../lib/posts';
import { categoryUrl } from '../lib/categories';

const posts = await getPosts();
const featured = pickFeatured(posts);
const rest = posts.filter((post) => post !== featured);
const side = rest.slice(0, 4);
const latest = rest.slice(4, 12);
const groups = groupByCategory(posts);
const themeSections = groups.filter((group) => group.posts.length >= 2);
const site = 'https://joaoa.com.br';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${site}/blog/#blog`,
  url: `${site}/blog/`,
  name: 'Blog de João Alberto',
  description: 'Design digital, email HTML, CRM, identidade visual e web, na prática.',
  inLanguage: 'pt-BR',
  author: { '@id': `${site}/#person` },
  publisher: { '@id': `${site}/#person` },
  isPartOf: { '@id': `${site}/#website` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${site}${postUrl(post)}`,
    datePublished: post.data.date.toISOString(),
  })),
};
---

<Base
  title="Blog — João Alberto"
  description="Design digital, email HTML, CRM, identidade visual e web, na prática: bastidores de projetos e soluções do dia a dia de um web designer."
  jsonLd={jsonLd}
>
  <header class="blog-head container">
    <div class="kicker mono"><span class="rule"></span>Blog</div>
    <h1 class="blog-title">Blog<span class="dot">.</span></h1>
    <p class="blog-desc">
      Design digital, email HTML, CRM, identidade visual e web, na prática: bastidores de projetos e soluções do dia a dia.
    </p>
  </header>

  {groups.length > 0 && <ThemeBar groups={groups} />}

  {featured ? (
    <>
      <section class={`hero container${side.length ? '' : ' hero--solo'}`} aria-label="Destaques">
        <PostCard post={featured} variant="feature" eager headingLevel="h2" />
        {side.length > 0 && (
          <div class="hero-side">
            {side.map((post) => <PostCard post={post} variant="card" />)}
          </div>
        )}
      </section>

      {latest.length > 0 && (
        <section class="block container" aria-labelledby="latest-title">
          <div class="block-head">
            <h2 id="latest-title" class="mono">Mais recentes</h2>
          </div>
          <div class="grid">
            {latest.map((post) => <PostCard post={post} variant="card" />)}
          </div>
        </section>
      )}

      {themeSections.map((group) => (
        <section class="block container" aria-labelledby={`tema-${group.slug}`}>
          <div class="block-head">
            <h2 id={`tema-${group.slug}`} class="mono">{group.name}</h2>
            <a href={categoryUrl(group.slug)} class="see-all">Ver tudo <i aria-hidden="true" class="fa-solid fa-arrow-right"></i></a>
          </div>
          <div class="rows">
            {group.posts.slice(0, 4).map((post) => <PostCard post={post} variant="row" />)}
          </div>
        </section>
      ))}

    </>
  ) : (
    <p class="empty container">Os primeiros posts estão a caminho.</p>
  )}

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">Tem um projeto em mente<span class="dot">?</span></h2>
    <p>Sites, identidades, campanhas e emails, do conceito ao código.</p>
    <div class="cta-actions">
      <a class="btn" href="/#contato"><span>Fale comigo</span><i aria-hidden="true" class="fa-solid fa-arrow-right"></i></a>
      <a class="btn btn--ghost" href="/projetos/"><span>Ver projetos</span><i aria-hidden="true" class="fa-solid fa-layer-group"></i></a>
    </div>
  </section>
</Base>
